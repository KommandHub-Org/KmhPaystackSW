{
    "name": "kommandhub/paystack-sw",
    "description": "Independent, third-party Shopware 6 integration for the Paystack payment gateway: accept secure payments via cards, bank transfers, USSD, and mobile money across Africa. Not affiliated with, endorsed by, or officially connected to Paystack.",
    "type": "shopware-platform-plugin",
    "version": "0.9.0-beta.3",
    "license": "Apache-2.0",
    "keywords": [
        "shopware",
        "shopware6",
        "shopware-plugin",
        "shopware-payment",
        "paystack",
        "payment",
        "payment-gateway",
        "checkout",
        "refund",
        "webhook",
        "mobile-money",
        "ussd",
        "bank-transfer",
        "africa",
        "nigeria",
        "ecommerce"
    ],
    "homepage": "https://github.com/KommandHub/KmhPaystackSW",
    "authors": [
        {
            "name": "Kommandhub Limited",
            "email": "info@kommandhub.com",
            "homepage": "https://kommandhub.com",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "info@kommandhub.com",
        "issues": "https://github.com/KommandHub/KmhPaystackSW/issues",
        "source": "https://github.com/KommandHub/KmhPaystackSW",
        "docs": "https://github.com/KommandHub/KmhPaystackSW/blob/main/README.md"
    },
    "require": {
        "shopware/core": "~6.6.0 || ~6.7.0",
        "shopware/storefront": "~6.6.0 || ~6.7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "shopware/dev-tools": "^1.5",
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan": "^2.1",
        "rregeer/phpunit-coverage-check": "^0.3.1"
    },
    "autoload": {
        "psr-4": {
            "Kommandhub\\PaystackSW\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kommandhub\\PaystackSW\\Tests\\": "tests/"
        }
    },
    "extra": {
        "shopware-plugin-class": "Kommandhub\\PaystackSW\\KmhPaystackSW",
        "label": {
            "de-DE": "Paystack-Zahlung von Kommandhub",
            "en-GB": "Paystack Payment by Kommandhub",
            "fr-FR": "Paiement Paystack par Kommandhub"
        },
        "description": {
            "de-DE": "Unabhängige Drittanbieter-Integration des Paystack-Gateways für Shopware 6: sichere Zahlungen per Karte, Überweisung, USSD und Mobile Money. Nicht mit Paystack verbunden.",
            "en-GB": "Independent third-party Shopware 6 integration for the Paystack payment gateway: secure card, bank transfer, USSD, and mobile money payments. Not affiliated with Paystack.",
            "fr-FR": "Intégration Shopware 6 indépendante et tierce pour la passerelle Paystack : paiements sécurisés par carte, virement, USSD et mobile money. Non affiliée à Paystack."
        },
        "manufacturerLink": {
            "de-DE": "https://kommandhub.com",
            "en-GB": "https://kommandhub.com"
        },
        "supportLink": {
            "de-DE": "https://kommandhub.com/support",
            "en-GB": "https://kommandhub.com/support"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
